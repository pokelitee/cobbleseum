[configuration]

entry_symbol = "cobbleseum_native_init"
compatibility_minimum = "4.5"

[libraries]

windows.debug.x86_64 = "res://game/native/bin/cobbleseum_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://game/native/bin/cobbleseum_native.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://game/native/bin/cobbleseum_native.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://game/native/bin/cobbleseum_native.linux.template_release.x86_64.so"
macos.debug = "res://game/native/bin/cobbleseum_native.macos.template_debug.framework"
macos.release = "res://game/native/bin/cobbleseum_native.macos.template_release.framework"
