{
  "_comment": "Prototype: which of Cobblemon's own move particle effects each move plays, and when (see CobblemonMoveFX). Only names and timings live here; the effects stay in the git-ignored cache.",
  "icebeam": {
    "speed": 1.6,
    "windup": [
      {"effect": "icebeam_actoremit", "at": "special"}
    ],
    "fire": [
      {"effect": "icebeam_actorpilot", "at": "special", "aim": true}
    ],
    "hit": [
      {"effect": "icebeam_target", "at": "target"},
      {"effect": "icebeam_targetbuild", "at": "middle"},
      {"effect": "icebeam_targetburst", "at": "target", "delay": 0.5},
      {"effect": "icebeam_targetfrost", "at": "target", "delay": 0.75}
    ]
  },
  "shadowball": {
    "speed": 1.4,
    "windup": [
      {"effect": "shadowball_actorcharge", "at": "special"}
    ],
    "flight": [
      {"effect": "shadowball_actorblob", "max": 3.0},
      {"effect": "shadowball_actorflaring", "max": 3.0}
    ],
    "hit": [
      {"effect": "shadowball_targetimpact", "at": "target", "max": 0.4},
      {"effect": "impact_ghost", "at": "target"}
    ]
  },
  "closecombat": {
    "speed": 1.5,
    "windup": [
      {"effect": "closecombat_dashlines", "at": "middle"}
    ],
    "hit": [
      {"effect": "closecombat_actor", "on": "user", "at": "middle"},
      {"effect": "closecombat_target", "at": "target", "face": "camera"},
      {"effect": "closecombat_target2", "at": "target", "face": "camera", "delay": 0.2}
    ]
  },
  "bulldoze": {
    "speed": 1.3,
    "blast": [
      {"effect": "bulldoze_actorquake", "at": "root"},
      {"effect": "bulldoze_actorspark", "at": "root"}
    ],
    "hit": [
      {"effect": "bulldoze_targetfloor", "at": "root", "aim": true, "aim_at": "root"}
    ]
  },
  "swordsdance": {
    "speed": 1.5,
    "windup": [
      {"effect": "swordsdance_actor", "at": "middle", "keep": true}
    ]
  }
}
