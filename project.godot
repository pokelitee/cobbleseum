; Engine configuration file.
; Pinned to Godot 4.7.2; see concepts_brief.md section 4.

config_version=5

[application]

config/name="Cobbleseum"
run/main_scene="res://game/presentation/battle_view.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/mix_rate=48000

[display]

; Clips are vertical 1080x1920. In viewport stretch mode the viewport size is the
; Movie Maker output size, while the window override keeps the window on screen.
window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="viewport"
