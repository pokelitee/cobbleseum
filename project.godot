; Engine configuration file.
; Pinned to Godot 4.7.2; see concepts_brief.md section 4.

config_version=5

[application]

config/name="Cobbleseum"
run/main_scene="res://game/presentation/battle_view.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/mix_rate=48000

[display]

; Play is landscape. In viewport stretch mode the viewport size is also the Movie Maker
; output size; tools/record.gd switches it per clip format with a temporary override.cfg.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
