; Engine configuration file.
; Pinned to Godot 4.7.2; see concepts_brief.md section 4.

config_version=5

[application]

config/name="Cobbleseum"
run/main_scene="res://game/presentation/battle_view.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[audio]

driver/mix_rate=48000

[display]

; Play is landscape. In viewport stretch mode the viewport size is also the Movie Maker
; output size; tools/record.gd switches it per clip format with a temporary override.cfg.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

[rendering]

; M8 rendering (concepts_brief.md §12.7): MSAA smooths geometry edges without blurring the
; nearest-filtered pixel textures (TAA and FXAA would); softer shadow filtering for the sun's
; and floodlights' soft shadows.
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
